{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GAM Analytics",
  "version": "0.8.0",
  "identifier": "br.gam.analytics",
  "build": {
    "frontendDist": "https://gam-analytics-web.vercel.app"
  },
  "app": {
    "windows": [
      {
        "title": "GAM Analytics",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "GAM",
    "shortDescription": "Painel operacional da unidade G.A.M",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
